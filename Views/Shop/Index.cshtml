@model List<TMPP.Models.Product>
@{
    ViewData["Title"] = "Shop";
}

<div class="hero" style="margin: 2rem 0;">
    <h1>Online Pharmacy</h1>
    <p>Browse our catalog and add items to your cart.</p>
</div>

@if (TempData["Message"] != null)
{
    <div style="background: rgba(16, 185, 129, 0.2); color: #34d399; padding: 1rem; border-radius: 0.5rem; margin-bottom: 1rem;">
        @TempData["Message"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div style="background: rgba(239, 68, 68, 0.2); color: #f87171; padding: 1rem; border-radius: 0.5rem; margin-bottom: 1rem;">
        @TempData["Error"]
    </div>
}

<div style="display: flex; gap: 2rem;">
    <!-- Product Catalog -->
    <div style="flex: 3; display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1.5rem;">
        @foreach(var p in Model)
        {
            <div class="pattern-card">
                <h3>@p.Name</h3>
                <p style="margin: 0.5rem 0; font-weight: bold; color: var(--primary);">$@p.Price.ToString("0.00")</p>
                <p style="margin: 0 0 1rem 0;">Stock: @(p.StockQuantity > 0 ? p.StockQuantity.ToString() : "OUT OF STOCK")</p>
                
                @if(p.StockQuantity > 0)
                {
                    <form method="post" action="/Shop/AddToCart">
                        <input type="hidden" name="productId" value="@p.Id" />
                        <button type="submit" class="btn" style="width: 100%;">Add to Cart</button>
                    </form>
                }
                else
                {
                    <form method="post" action="/Shop/Subscribe" style="margin-top: auto;">
                        <input type="hidden" name="productId" value="@p.Id" />
                        <div class="form-group" style="margin-bottom: 0.5rem;">
                            <input type="text" name="customerName" class="form-control" placeholder="Your Name" required />
                        </div>
                        <button type="submit" class="btn btn-secondary" style="width: 100%;">Notify when in stock</button>
                    </form>
                }
            </div>
        }
    </div>

    <!-- Cart Sidebar -->
    <div style="flex: 1; background: var(--card-bg); border-radius: 1rem; padding: 1.5rem; border: 1px solid var(--border-color); height: fit-content;">
        <h3>Your Cart</h3>
        <hr style="border-color: var(--border-color); margin: 1rem 0;" />
        
        @{
            var cartItems = TMPP.Models.Database.Cart.Items;
            double total = cartItems.Sum(i => i.Price);
        }
        
        @if(cartItems.Count == 0)
        {
            <p style="color: #94a3b8;">Cart is empty.</p>
        }
        else
        {
            <ul style="list-style: none; padding: 0; margin: 0 0 1.5rem 0;">
                @foreach(var item in cartItems)
                {
                    <li style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                        <span>@item.Name</span>
                        <span>$@item.Price.ToString("0.00")</span>
                    </li>
                }
            </ul>
            <div style="display: flex; justify-content: space-between; font-weight: bold; font-size: 1.2rem; margin-bottom: 1.5rem;">
                <span>Total:</span>
                <span style="color: var(--primary);">$@total.ToString("0.00")</span>
            </div>
            
            <a href="/Checkout" class="btn" style="display: block; text-align: center; text-decoration: none; margin-bottom: 0.5rem;">Proceed to Checkout</a>
        }
        
        <form method="post" action="/Shop/UndoCart">
            <button type="submit" class="btn btn-secondary" style="width: 100%;">Undo Last Action</button>
        </form>
    </div>
</div>
