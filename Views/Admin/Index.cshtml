@model List<TMPP.Models.Product>
@{
    ViewData["Title"] = "Admin Portal";
    var logs = TempData["AdminLogs"] as string[];
    var config = ViewData["Config"] as TMPP.Creational.Singleton.PharmacyConfigManager;
}

<div class="hero" style="margin: 2rem 0;">
    <h1>Admin Portal</h1>
    <p>Manage inventory, legacy suppliers, and pharmacy configuration.</p>
</div>

@if (logs != null)
{
    <div class="log-box" style="margin-bottom: 2rem;">
        @foreach (var log in logs)
        {
            <div style="margin-bottom: 0.5rem;">> @log</div>
        }
    </div>
}

<div style="display: flex; gap: 2rem;">
    <!-- Inventory Management -->
    <div class="demo-container" style="flex: 2; margin-top: 0;">
        <h3>Inventory Management</h3>
        <table style="width: 100%; text-align: left; border-collapse: collapse; margin-bottom: 2rem;">
            <thead>
                <tr style="border-bottom: 1px solid var(--border-color);">
                    <th style="padding: 1rem 0;">ID</th>
                    <th style="padding: 1rem 0;">Name</th>
                    <th style="padding: 1rem 0;">Stock</th>
                    <th style="padding: 1rem 0;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                        <td style="padding: 1rem 0;">@p.Id</td>
                        <td style="padding: 1rem 0;">@p.Name</td>
                        <td style="padding: 1rem 0; font-weight: bold; color: @(p.StockQuantity == 0 ? "#ef4444" : "#34d399")">@p.StockQuantity</td>
                        <td style="padding: 1rem 0;">
                            <form method="post" action="/Admin/OrderLegacy" style="display: inline-block;">
                                <input type="hidden" name="productId" value="@p.Id" />
                                <input type="hidden" name="quantity" value="50" />
                                <button type="submit" class="btn btn-secondary" style="padding: 0.5rem 1rem; font-size: 0.8rem;">Order (Legacy API)</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <h4>Manual Restock (Proxy Pattern Demo)</h4>
        <form method="post" action="/Admin/AddStock" style="background: rgba(15, 23, 42, 0.5); padding: 1.5rem; border-radius: 0.5rem;">
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Simulate Role</label>
                    <select name="role" class="form-control">
                        <option value="Customer">Customer (Access Denied)</option>
                        <option value="Pharmacist">Pharmacist (Access Granted)</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Product</label>
                    <select name="productId" class="form-control">
                        @foreach(var p in Model) { <option value="@p.Id">@p.Name</option> }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Qty</label>
                    <input type="number" name="quantity" class="form-control" value="10" />
                </div>
            </div>
            <button type="submit" class="btn" style="width: 100%;">Attempt Restock</button>
        </form>
    </div>

    <div style="flex: 1; display: flex; flex-direction: column; gap: 2rem;">
        <!-- Add New Product -->
        <div class="demo-container" style="margin-top: 0; height: fit-content;">
            <h3>Add New Product</h3>
            <hr style="border-color: var(--border-color); margin: 1rem 0;" />
            <form method="post" action="/Admin/AddProduct">
                <div class="form-group">
                    <label class="form-label">Product Name</label>
                    <input type="text" name="name" class="form-control" placeholder="Ibuprofen 400mg" required />
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Price ($)</label>
                        <input type="number" step="0.01" name="price" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Initial Stock</label>
                        <input type="number" name="stock" class="form-control" value="0" required />
                    </div>
                </div>
                <div class="form-group">
                    <label class="checkbox-label">
                        <input type="checkbox" name="cold" value="true" />
                        Requires Cold Storage
                    </label>
                </div>
                <button type="submit" class="btn" style="width: 100%;">Create Product</button>
            </form>
        </div>

        <!-- Settings (Singleton) -->
        <div class="demo-container" style="margin-top: 0; height: fit-content;">
        <h3>Pharmacy Settings (Singleton)</h3>
        <hr style="border-color: var(--border-color); margin: 1rem 0;" />
        <form method="post" action="/Admin/SaveConfig">
            <div class="form-group">
                <label class="form-label">Pharmacy Name</label>
                <input type="text" name="name" class="form-control" value="@config.PharmacyName" required />
            </div>
            <div class="form-group">
                <label class="form-label">Opening Hours</label>
                <input type="text" name="hours" class="form-control" value="@config.OpeningHour" required />
            </div>
            <button type="submit" class="btn" style="width: 100%;">Save Global Config</button>
        </form>
    </div>
    </div>
</div>
